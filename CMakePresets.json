{
    "version": 3,
    "configurePresets": [
        {
            "name": "dev",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/dev",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "dev-tcp",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/dev-tcp",
            "cacheVariables": {
                "UNITY_TCP_CAM": "ON"
            }
        },
        {
            "name": "tui",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/tui-dev",
            "cacheVariables": {
                "TUI_BUILD": "ON"
            }
        },
        {
            "name": "devtools",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/devtools",
            "cacheVariables": {
                "DEV_TOOLS": "ON"
            }
        },
        {
            "name": "test",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/test",
            "cacheVariables": {
                "ST_BUILD_TESTS": "ON",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "dev",
            "targets": [
                "startracker"
            ],
            "configurePreset": "dev",
            "jobs": 7
        },
        {
            "name": "dev-tcp",
            "targets": [
                "startracker"
            ],
            "configurePreset": "dev-tcp",
            "jobs": 7
        },
        {
            "name": "tui",
            "targets": [
                "startracker"
            ],
            "configurePreset": "tui",
            "jobs": 7
        },
        {
            "name": "devtools",
            "targets": [
                "Bin_Gen",
                "Lookup_Gen"
            ],
            "configurePreset": "devtools",
            "jobs": 7
        },
        {
            "name": "test",
            "targets": [
                "test_math",
                "test_attitude",
                "test_identification",
                "test_catalog_loader",
                "test_image_proc",
                "test_config",
                "test_hal"
            ],
            "configurePreset": "test",
            "jobs": 7
        }
    ],
    "testPresets": [
        {
            "name": "test",
            "configurePreset": "test",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
